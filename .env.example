# Plantilla. Copia este archivo a .env.local (que está en .gitignore) y pon ahí las keys reales.
# Este archivo sí se sube al repo: NUNCA pongas keys reales aquí.

# --- IA del planificador (OpenRouter, igual que Genial Skills Maestro) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o

# --- API de lecciones de Athenas (misma key de los otros proyectos) ---
ATHENAS_API_KEY=
ATHENAS_API_BASE=https://athenasapi-dev.genialskillsweb.com

# --- Visor de lecciones (opcional). Por defecto: el despliegue de genial-skills-redesign.
# VITE_LESSON_VIEWER_URL=https://genial-skills-redesign.vercel.app/
